PARKMAP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PARKMAP_MODEL_PATH=models/best.pt
PARKMAP_MODEL_IMGSZ=960
PARKMAP_MODEL_CONF=0.25
PARKMAP_MODEL_NMS_IOU=0.50
# Motorcycle class in the weights: 0 for ParkMap weights, 3 for COCO-pretrained YOLO.
PARKMAP_MODEL_CLASS_ID=0
PARKMAP_DEVICE=cpu
PARKMAP_MAX_UPLOAD_MB=25
PARKMAP_MAX_IMAGE_PIXELS=40000000

# Optional development validation thresholds
PARKMAP_HOMOGRAPHY_WARNING_RMSE_M=0.50
PARKMAP_HOMOGRAPHY_WARNING_MAX_ERROR_M=1.00
PARKMAP_PHYSICAL_ROW_WARNING_RELATIVE_PERCENT=5.0

# Live state storage (Postgres). Plain postgresql:// URLs use the psycopg 3 driver.
# Local: docker compose up -d postgres (root compose.yaml), then alembic upgrade head.
# Supabase transaction pooler (port 6543) is not supported yet; use the session pooler or a direct connection.
DATABASE_URL=postgresql://parkmap:parkmap@localhost:5432/parkmap
PARKMAP_STATE_FRESHNESS_S=15

# Worker ingestion. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PARKMAP_WORKER_TOKEN=
# Worker only: base URL of this API.
PARKMAP_API_URL=http://localhost:8000
# Operator editor only. start-dev.bat supplies a temporary shared token automatically.
# For manual startup, set the same private value in the API and Calibration UI server.
PARKMAP_EDITOR_TOKEN=
