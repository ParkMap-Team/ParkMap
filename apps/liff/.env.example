# Server only: base URL of the ParkMap API (apps/vision-api).
PARKMAP_API_URL=http://localhost:8000
# Server only, optional: site the home screen opens instead of sripatum, e.g. dev-site locally.
PARKMAP_DEFAULT_SITE_ID=
# LIFF app ID from the LINE Developers console. Optional in local development.
NEXT_PUBLIC_LIFF_ID=
# Optional: LINE ID of the official account, with its @. Settings links to its chat for reports.
NEXT_PUBLIC_LINE_OA_ID=
# Server only: base URL of the LINE settings service. Locally, scripts/dev-line-settings.mjs.
PARKMAP_SETTINGS_URL=http://127.0.0.1:3091
# Development only: 1 skips LIFF and signs in to the local settings stand-in (README, Local LINE login).
NEXT_PUBLIC_PARKMAP_DEV_LINE_LOGIN=
# Development only: hostname of your Cloudflare Tunnel to this dev server, without https://.
DEV_TUNNEL_HOST=
