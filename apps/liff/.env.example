# Server only: base URL of the ParkMap API (apps/vision-api).
PARKMAP_API_URL=http://localhost:8000
# Server only, optional: site the home screen opens on. Unset or unknown, the home screen opens the
# only site, or the site list when there are several.
PARKMAP_DEFAULT_SITE_ID=
# LIFF app ID from the LINE Developers console. Optional in local development.
NEXT_PUBLIC_LIFF_ID=
# Development only: hostname of your Cloudflare Tunnel to this dev server, without https://.
DEV_TUNNEL_HOST=
